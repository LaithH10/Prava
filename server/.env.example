# Copy to server/.env and fill in real values. Never commit server/.env.
PORT=8000
# MongoDB Atlas connection string, e.g. mongodb+srv://<user>:<password>@<cluster-host>/<db-name>
DATABASE_URL=
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173
# Auth0 (not secrets): tenant domain without https://, and the API identifier (audience)
AUTH0_DOMAIN=<tenant>.eu.auth0.com
AUTH0_AUDIENCE=https://api.prava
