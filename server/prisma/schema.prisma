generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "mongodb"
    url      = env("DATABASE_URL")
}

model User {
    id               String      @id @default(auto()) @map("_id") @db.ObjectId
    // Auth0 `sub`, e.g. "auth0|abc" or "google-oauth2|123". The only identity key.
    authId           String      @unique
    // Profile data from the token; not unique, since one person may log in two ways.
    email            String?
    emailVerified    Boolean     @default(false)
    name             String?
    image            String?
    bookedVisits     Json[]
    favResidenciesID String[]    @db.ObjectId
    ownedResidencies Residency[] @relation("Owner")
}

model Residency {
    id          String   @id @default(auto()) @map("_id") @db.ObjectId
    title       String
    description String
    price       Int
    address     String
    city        String
    country     String
    image       String
    facilities  Json
    ownerId     String   @db.ObjectId
    owner       User     @relation("Owner", fields: [ownerId], references: [id])
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    @@unique(fields: [address, ownerId])
}
