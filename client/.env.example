# Copy to client/.env.local. Vite exposes only VITE_* variables to the browser, so never put secrets here.
VITE_API_URL=http://localhost:8000/api
# Auth0 (public by design in a SPA): tenant domain, the SPA's client ID, and the API identifier
VITE_AUTH0_DOMAIN=<tenant>.eu.auth0.com
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=https://api.prava
